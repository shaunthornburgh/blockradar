APP_NAME="Block Radar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Origin(s) allowed to call the API. Comma separated.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — "mysql" is the compose service name, not localhost.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=block_radar
DB_USERNAME=block_radar
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Redis — cache, queue and sessions
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@blockradar.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Block Radar — data sources (not wired up yet)
# ---------------------------------------------------------------------------
# HM Land Registry CCOD. Free key: https://use-land-property-data.service.gov.uk
HMLR_API_KEY=
CCOD_STORAGE_PATH=ccod
CCOD_CHUNK_SIZE=2000

# Companies House. Free key: https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# The API allows 600 requests per 5 minutes. This sits below it because the
# local throttle uses a fixed window and theirs is rolling.
COMPANIES_HOUSE_RATE_LIMIT=550
COMPANIES_HOUSE_STALE_DAYS=30
COMPANIES_HOUSE_MAX_ATTEMPTS=5
# Each of these costs one extra request per company. Charges are only fetched
# when the profile says the company has any; officers are off by default
# because enabling them roughly halves throughput.
COMPANIES_HOUSE_FETCH_CHARGES=true
COMPANIES_HOUSE_FETCH_OFFICERS=false
COMPANIES_HOUSE_STORE_RAW=true
COMPANIES_HOUSE_TIMEOUT=15

# ---------------------------------------------------------------------------
# EPC (Energy Performance Certificates), free from MHCLG.
# Bulk download is the primary source; the developer API only returns a
# summary and cannot supply floor area or property characteristics.
# https://get-energy-performance-data.communities.gov.uk
# ---------------------------------------------------------------------------
EPC_STORAGE_PATH=epc
EPC_CHUNK_SIZE=1000
# Discard certificates in postcodes we hold no titles in.
EPC_RESTRICT_POSTCODES=true
# Bearer token from your account page (not Basic auth).
EPC_API_TOKEN=
EPC_API_RATE_LIMIT=5500
# Building-name similarity required for a medium confidence match.
EPC_FUZZY_THRESHOLD=82
# high | medium | low. Low accepts postcode-only matches and will corrupt
# unit counts by attaching neighbouring buildings.
EPC_MIN_CONFIDENCE=medium
EPC_STALE_DAYS=180

# Candidate filters — empty means no restriction.
# CANDIDATE_REGIONS="North West,Yorkshire and The Humber"
# CANDIDATE_POSTCODE_AREAS="M,LS,B"

# Scoring thresholds
SCORING_HIGH_PRIORITY_THRESHOLD=70
SCORING_MINIMUM_GROSS_YIELD=6.0
SCORING_MINIMUM_UNITS=4
