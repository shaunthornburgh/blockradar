[mysqld]
# Tuned for bulk-loading the monthly CCOD extract (~3.5M rows) on a dev machine.

character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Raise on a machine with more RAM; this is the single biggest import lever.
innodb_buffer_pool_size = 1G
# Replaces the deprecated innodb_log_file_size on MySQL 8.0.30+.
innodb_redo_log_capacity = 512M

# Flush once per second rather than per commit. Acceptable for a rebuildable
# analytics database, NOT for one holding the only copy of critical data.
innodb_flush_log_at_trx_commit = 2

max_allowed_packet = 256M

# Needed if the importer switches to LOAD DATA LOCAL INFILE.
local_infile = 1

sort_buffer_size = 4M
join_buffer_size = 4M

max_connections = 200

skip_name_resolve = 1

[client]
default-character-set = utf8mb4
