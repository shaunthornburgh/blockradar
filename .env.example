# ---------------------------------------------------------------------------
# Compose-level settings. Copy to .env:  cp .env.example .env
#
# This file configures docker-compose.yml only. Laravel's own settings live in
# backend/.env — keep DB_* in sync between the two.
# ---------------------------------------------------------------------------

APP_NAME="Block Radar"

# Build targets: development (bind mounts + hot reload) or production.
BACKEND_TARGET=development
FRONTEND_TARGET=development

# ---------------------------------------------------------------------------
# File ownership inside the containers.
#
# On Linux these must match your host user or bind-mounted files end up
# root-owned. Set them with:  echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
# On macOS Docker Desktop maps ownership for you and the defaults are fine.
# ---------------------------------------------------------------------------
UID=1000
GID=1000

# ---------------------------------------------------------------------------
# Published host ports. Change these if something already owns them.
# ---------------------------------------------------------------------------
BACKEND_FORWARD_PORT=8000
FRONTEND_FORWARD_PORT=3000
DB_FORWARD_PORT=3306
REDIS_FORWARD_PORT=6379

# ---------------------------------------------------------------------------
# MySQL. Used to provision the container on first boot.
# ---------------------------------------------------------------------------
DB_DATABASE=block_radar
DB_USERNAME=block_radar
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ---------------------------------------------------------------------------
# Where the Nuxt frontend finds the API.
#
# The browser goes through the published nginx port; server-side rendering
# stays inside the compose network.
# ---------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_API_INTERNAL_BASE=http://nginx/api
